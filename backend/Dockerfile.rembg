FROM python:3.9-slim
WORKDIR /app
# Install system dependencies needed for rembg
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir rembg pillow fastapi uvicorn pydantic

COPY rembg_service.py .

EXPOSE 5001

CMD ["uvicorn", "rembg_service:app", "--host", "0.0.0.0", "--port", "5001"]
